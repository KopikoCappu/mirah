# Copy to .env.local for local development, or just run: bash scripts/setup.sh
# The server only needs the values below. Your keys (Google sign-in, Jev, Outlook) are entered
# in the browser at /setup and stored encrypted in Firestore.

APP_URL=http://localhost:3000
GOOGLE_CLOUD_PROJECT=your-project-id
# Only outside Google Cloud (e.g. Vercel): a service account key with the Cloud Datastore User role, as raw JSON or base64
# GOOGLE_SERVICE_ACCOUNT_JSON=

# Generate each with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=
TOKEN_ENCRYPTION_KEY=
CRON_SECRET=

# Optional. If set, these override what's entered in /setup.
# ALLOWED_EMAILS=you@gmail.com
# JEV_API_KEY=
# JEV_BASE_URL=https://ai-gateway.vercel.sh/typesafe   # only when using Vercel AI Gateway
# JEV_MODEL=typesafe-ai/jev
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MS_CLIENT_ID=
# MS_CLIENT_SECRET=
